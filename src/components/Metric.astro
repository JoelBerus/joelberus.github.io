---
/** Big mono number with a caption underneath, e.g. "42%" / "faster builds". */
interface Props {
  /** The number or short value, e.g. "42", "3.2", "<100". */
  value: string | number;
  /** Optional unit rendered smaller next to the value, e.g. "%", "ms", "x". */
  unit?: string;
  /** What the number means. */
  caption: string;
  /** Color of the value. */
  tone?: 'default' | 'accent' | 'data';
  class?: string;
}

const { value, unit, caption, tone = 'default', class: className } = Astro.props;
---

<div class:list={['metric', `metric--${tone}`, className]}>
  <p class="metric__value">
    <span>{value}</span>{unit && <span class="metric__unit">{unit}</span>}
  </p>
  <p class="metric__caption">{caption}</p>
</div>

<style>
  .metric {
    display: grid;
    gap: var(--space-2);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-line-strong);
  }

  .metric__value {
    font-family: var(--font-mono);
    font-size: var(--text-3xl);
    font-weight: var(--weight-medium);
    font-variant-numeric: tabular-nums;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--metric-color, var(--color-text));
  }

  .metric--accent {
    --metric-color: var(--color-accent);
  }

  .metric--data {
    --metric-color: var(--color-data);
  }

  .metric__unit {
    margin-left: 0.15em;
    font-size: 0.5em;
    letter-spacing: 0;
    color: var(--color-text-muted);
  }

  .metric__caption {
    max-width: 24ch;
    font-size: var(--text-sm);
    line-height: 1.4;
    color: var(--color-text-muted);
  }
</style>
