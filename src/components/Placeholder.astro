---
/**
 * Temporary stand-in for section content that has not been written yet.
 * Delete this component once every home section has real content.
 */
interface Props {
  /** Short note about what will go here. */
  note: string;
}

const { note } = Astro.props;
---

<div class="placeholder">
  <p class="mono-label">{note}</p>
</div>

<style>
  .placeholder {
    display: grid;
    place-items: center;
    min-height: 12rem;
    padding: var(--space-6);
    border: 1px dashed var(--color-line-strong);
    border-radius: var(--radius-md);
    text-align: center;
  }
</style>
