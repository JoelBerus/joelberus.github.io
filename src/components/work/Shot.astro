---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * Product screenshot in a thin device-like frame.
 * `phone` gets large rounded corners, `wide` a small-radius window frame.
 * The image is responsive: pass `sizes` matching the layout slot it fills.
 */
interface Props {
  image: ImageMetadata;
  alt: string;
  kind: 'wide' | 'phone';
  /** CSS `sizes` for the slot this image fills. */
  sizes: string;
  /** Above-the-fold images load eagerly with high priority. */
  eager?: boolean;
  class?: string;
}

const { image, alt, kind, sizes, eager = false, class: className } = Astro.props;

const candidates = kind === 'phone' ? [240, 360, 480, 600, 780] : [640, 960, 1280, 1920, 2560];
// Never ask for more pixels than the source has.
const widths = [...new Set(candidates.map((width) => Math.min(width, image.width)))];
---

<span class:list={['shot', `shot--${kind}`, className]}>
  <Image
    src={image}
    alt={alt}
    widths={widths}
    sizes={sizes}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : undefined}
    decoding={eager ? 'sync' : 'async'}
  />
</span>

<style>
  .shot {
    display: block;
    overflow: hidden;
    border: 1px solid var(--shot-line, var(--color-line-strong));
    background: var(--color-surface-2);
  }

  .shot :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .shot--wide {
    border-radius: var(--radius-md);
  }

  /* Radius scales with the frame so small and large phones look alike. */
  .shot--phone {
    border-radius: clamp(0.75rem, 9%, 1.75rem) / clamp(0.75rem, 4.4%, 1.75rem);
  }
</style>
