---
import Button from '../Button.astro';
import Section from '../Section.astro';
import { sectionNumber } from '../../config/site';
import Tag from '../Tag.astro';
import { wasmSize } from '../field/wasm-size';
import { FIELD_SOURCE_URL, rustContent } from '../../data/rust';
import { asistenteHogar } from '../../data/work/asistente-hogar';
import { workPath } from '../../data/work';
import { localizePath, useTranslations, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const tr = useTranslations(locale);
const copy = rustContent[locale].rust;

/** Fills the build-time numbers into a sentence from the content file. */
const withSizes = (text: string) => text.replace('{gzip}', wasmSize.gzipKb).replace('{raw}', wasmSize.rawKb);

const items = [
  { ...copy.crate, index: 'A', tone: 'accent' as const, href: FIELD_SOURCE_URL, external: true },
  {
    ...copy.assistant,
    index: 'B',
    tone: 'default' as const,
    href: localizePath(workPath(asistenteHogar.slug), locale),
    external: false,
  },
];
---

<Section id="rust" index={sectionNumber('rust')} label={tr('rust.label')} title={tr('rust.title')} raised>
  <p slot="lead">{copy.lead}</p>

  <div class="rust-grid">
    {
      items.map((item) => (
        <article class="rust-item">
          <p class="rust-item__eyebrow mono-label">
            <span class:list={['rust-item__index', `rust-item__index--${item.tone}`]}>{item.index}</span>
            <span>{item.eyebrow}</span>
          </p>
          <h3 class="rust-item__title">{item.title}</h3>
          <p class="rust-item__body">{item.body}</p>

          <dl class="rust-item__facts">
            {item.facts.map((fact) => (
              <div class="rust-item__fact">
                <dt>{fact.term}</dt>
                <dd>{withSizes(fact.detail)}</dd>
              </div>
            ))}
          </dl>

          <div class="rust-item__footer">
            <ul class="cluster" role="list">
              {item.tags.map((tag) => (
                <li>
                  <Tag>{tag}</Tag>
                </li>
              ))}
            </ul>
            <Button href={item.href} variant="ghost" size="sm" external={item.external} arrow>
              {item.link}
              {item.external && <span class="visually-hidden"> ({tr('a11y.external')})</span>}
            </Button>
          </div>
        </article>
      ))
    }
  </div>

  <p class="rust-honesty">{copy.honesty}</p>
</Section>

<style>
  .rust-grid {
    display: grid;
    gap: var(--space-6);
  }

  .rust-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-5);
    border: var(--border-hairline);
    border-radius: var(--radius-md);
    background: var(--color-bg);
  }

  .rust-item__eyebrow {
    display: flex;
    align-items: baseline;
    gap: 0.8em;
  }

  .rust-item__index {
    color: var(--color-text-subtle);
  }

  .rust-item__index--accent {
    color: var(--color-accent);
  }

  .rust-item__title {
    font-size: var(--text-xl);
  }

  .rust-item__body {
    max-width: 60ch;
    color: var(--color-text-muted);
  }

  .rust-item__facts {
    display: grid;
    margin: 0;
    border-top: var(--border-hairline);
  }

  .rust-item__fact {
    display: grid;
    gap: var(--space-1);
    padding-block: var(--space-3);
    border-bottom: var(--border-hairline);
  }

  .rust-item__fact dt {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.02em;
    color: var(--color-text);
  }

  .rust-item__fact dd {
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.55;
    color: var(--color-text-muted);
  }

  .rust-item__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: auto;
    padding-top: var(--space-2);
  }

  .rust-honesty {
    max-width: 68ch;
    margin-top: var(--space-6);
    padding-left: var(--space-4);
    border-left: 2px solid var(--color-accent-line);
    color: var(--color-text-muted);
  }

  @media (min-width: 30rem) {
    .rust-item {
      padding: var(--space-6);
    }
  }

  @media (min-width: 40rem) {
    .rust-item__fact {
      grid-template-columns: 11rem minmax(0, 1fr);
      gap: var(--space-4);
    }
  }

  @media (min-width: 64rem) {
    .rust-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .rust-item__fact {
      grid-template-columns: 9.5rem minmax(0, 1fr);
    }
  }
</style>
