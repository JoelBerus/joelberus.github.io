---
import Section from '../Section.astro';
import WorkCard from '../work/WorkCard.astro';
import { workCases, workUi } from '../../data/work';
import { useTranslations, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const tr = useTranslations(locale);
---

<Section id="work" index="01" label={tr('work.label')} title={tr('work.title')}>
  <p slot="lead">{workUi.sectionLead[locale]}</p>
  <ul class="work-grid" role="list">
    {
      workCases.map((work) => (
        <li>
          <WorkCard work={work} locale={locale} />
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .work-grid {
    display: grid;
    gap: var(--space-5);
  }

  @media (min-width: 52rem) {
    .work-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
