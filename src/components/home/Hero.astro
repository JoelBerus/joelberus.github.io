---
import Button from '../Button.astro';
import { wasmSize } from '../field/wasm-size';
import { cvPath, site } from '../../config/site';
import { FIELD_SOURCE_URL, rustContent } from '../../data/rust';
import { useTranslations, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = rustContent[locale].hero;
const tr = useTranslations(locale);
const cvHref = `${import.meta.env.BASE_URL}${cvPath[locale]}`;
---

<section id="hero" class="hero" aria-labelledby="hero-title">
  <!--
    Mount point for the Rust/WASM canvas (see src/components/field/mount.ts).
    It fills the whole hero and sits behind the text. Until the module loads,
    or if it never does, the CSS dot grid below is what the visitor sees.
  -->
  <div id="field-canvas-mount" class="hero__field" aria-hidden="true"></div>

  <div class="container hero__content">
    <h1 id="hero-title" class="hero__name">{site.name}</h1>
    <p class="hero__tagline">{copy.tagline}</p>
    <p class="hero__support">{copy.support}</p>
    <ul class="hero__facts" role="list">
      {copy.facts.map((fact) => <li>{fact}</li>)}
    </ul>

    <div class="hero__footer">
      <div class="cluster hero__actions">
        <Button href="#experience" arrow>{copy.ctaExperience}</Button>
        <Button href="#contact" variant="ghost">{copy.ctaContact}</Button>
        <Button href={cvHref} variant="ghost" download>
          {tr('cv.download')} <span class="hero__cv-format">{tr('cv.format')}</span>
        </Button>
      </div>

      <!-- The size is measured at build time; ms/step is filled in by the script below. -->
      <p class="hero__chip">
        <span class="hero__chip-dot" aria-hidden="true"></span>
        <span>{copy.chipLabel}</span>
        <span class="hero__chip-sep" aria-hidden="true">·</span>
        <span title={copy.chipSizeTitle}>{wasmSize.gzipKb} kB</span>
        <span class="hero__chip-live" title={copy.chipStepTitle} data-field-stats hidden>
          <span class="hero__chip-sep" aria-hidden="true">·</span>
          <span class="hero__chip-value" data-field-ms></span>
          {copy.chipStepUnit}
        </span>
        <span class="hero__chip-sep" aria-hidden="true">·</span>
        <a href={FIELD_SOURCE_URL} aria-label={copy.chipSourceLabel}>{copy.chipSource}</a>
      </p>
    </div>
  </div>
</section>

<script>
  const mount = document.getElementById('field-canvas-mount');
  const hero = document.getElementById('hero');

  if (mount && hero) {
    const stats = hero.querySelector<HTMLElement>('[data-field-stats]');
    const value = hero.querySelector<HTMLElement>('[data-field-ms]');

    const onStats = (msPerStep: number) => {
      if (!stats || !value) return;
      value.textContent = msPerStep < 0.005 ? '<0.01' : msPerStep.toFixed(2);
      stats.hidden = false;
    };

    const start = () => {
      // The simulation is a separate chunk: neither the WebAssembly module
      // nor its glue code is on the critical path of the page.
      import('../field/mount')
        .then(({ mountField }) => mountField(mount, { pointerTarget: hero, onStats }))
        .catch(() => {
          // No WebAssembly, a blocked request, an old browser: the CSS dot
          // grid stays as the background and nothing else changes.
        });
    };

    // Wait until the browser has painted and is idle before fetching anything.
    if ('requestIdleCallback' in window) {
      requestIdleCallback(start, { timeout: 1500 });
    } else {
      setTimeout(start, 200);
    }
  }
</script>

<style>
  .hero {
    position: relative;
    display: grid;
    /* Capped so a very tall viewport does not turn the hero into an empty wall. */
    min-height: min(76vh, 52rem);
    min-height: min(76svh, 52rem);
    border-bottom: var(--border-hairline);
    isolation: isolate;
  }

  .hero > * {
    grid-area: 1 / 1;
  }

  .hero__field {
    position: relative;
    z-index: 0;
    width: 100%;
    min-height: min(76vh, 52rem);
    min-height: min(76svh, 52rem);
    overflow: hidden;
    /* Static fallback shown until (or instead of) the canvas. */
    background-image: radial-gradient(circle at center, var(--color-line) 1px, transparent 1.5px);
    background-size: 24px 24px;
    background-position: center;
  }

  .hero__field :global(canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1200ms ease;
  }

  .hero__field[data-field-ready] :global(canvas) {
    opacity: 1;
  }

  /*
   * Keeps the text readable over the field: the page background fades in from
   * the bottom and from the left, where the copy sits.
   */
  .hero::after {
    content: '';
    grid-area: 1 / 1;
    z-index: 1;
    background:
      linear-gradient(to top, var(--color-bg) 0%, rgb(11 14 17 / 0.72) 38%, transparent 80%),
      linear-gradient(to right, rgb(11 14 17 / 0.78) 0%, rgb(11 14 17 / 0.35) 45%, transparent 75%);
    pointer-events: none;
  }

  .hero__content {
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: var(--space-5);
    padding-block: var(--space-9) var(--space-7);
    /* Let pointer events reach the hero background except on real content. */
    pointer-events: none;
  }

  .hero__content > *,
  .hero__footer > * {
    pointer-events: auto;
  }

  .hero__footer {
    pointer-events: none;
  }

  .hero__name {
    max-width: 12ch;
  }

  .hero__tagline {
    max-width: 44ch;
    font-family: var(--font-mono);
    font-size: var(--text-base);
    line-height: 1.5;
    color: var(--color-text);
  }

  .hero__support {
    max-width: 52ch;
    margin-top: calc(var(--space-2) * -1);
    font-size: var(--text-lg);
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  /* One compact row of facts a recruiter scans for: place, languages, availability. */
  .hero__facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-5);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.02em;
    line-height: 1.6;
    color: var(--color-text);
  }

  .hero__facts li {
    display: flex;
    align-items: center;
    gap: 0.7em;
  }

  .hero__facts li::before {
    content: '';
    flex: none;
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 1px;
    background: var(--color-accent);
  }

  .hero__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4) var(--space-6);
    margin-top: var(--space-2);
  }

  .hero__actions {
    --cluster-gap: var(--space-3);
  }

  .hero__cv-format {
    margin-left: 0.35em;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
  }

  /* A quiet footnote about the background, not a headline. */
  .hero__chip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.1em 0.55em;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
    line-height: 1.5;
    color: var(--color-text-subtle);
  }

  .hero__chip-dot {
    width: 0.4em;
    height: 0.4em;
    border-radius: var(--radius-full);
    background: var(--color-text-subtle);
  }

  .hero__chip-sep {
    color: var(--color-line-strong);
  }

  .hero__chip-live {
    display: inline-flex;
    gap: 0.6em;
  }

  .hero__chip-live[hidden] {
    display: none;
  }

  .hero__chip a {
    color: var(--color-text-muted);
    text-decoration: underline;
    text-decoration-color: var(--color-line-strong);
    text-underline-offset: 0.25em;
  }

  .hero__chip a:hover {
    color: var(--color-accent);
    text-decoration-color: currentColor;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__field :global(canvas) {
      transition: none;
    }
  }
</style>
