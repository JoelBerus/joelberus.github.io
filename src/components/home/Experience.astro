---
import Metric from '../Metric.astro';
import Section from '../Section.astro';
import { sectionNumber } from '../../config/site';
import { education, roles } from '../../data/experience';
import { highlights } from '../../data/profile';
import { useTranslations, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const tr = useTranslations(locale);

const monthFormat = new Intl.DateTimeFormat(locale, {
  month: 'short',
  year: 'numeric',
  timeZone: 'UTC',
});

/** "2023-07" -> "Jul 2023" / "jul 2023". */
function formatMonth(iso: string): string {
  return monthFormat.format(new Date(`${iso}-01T00:00:00Z`)).replace('.', '');
}
---

<Section id="experience" index={sectionNumber('experience')} label={tr('experience.label')} title={tr('experience.title')}>
  <p slot="lead">{tr('experience.lead')}</p>

  <h3 class="visually-hidden">{tr('experience.highlights')}</h3>
  <ul class="highlights" role="list">
    {
      highlights.map((item) => (
        <li>
          <Metric
            value={item.value}
            unit={item.unit}
            caption={item.caption[locale]}
            tone={item.tone}
          />
        </li>
      ))
    }
  </ul>

  <ol class="ledger" role="list">
    {
      roles.map((role) => (
        <li class="entry">
          <div class="entry__meta">
            <p class="entry__period">
              <time datetime={role.start}>{formatMonth(role.start)}</time>
              <span aria-hidden="true"> – </span>
              <span class="visually-hidden"> – </span>
              {role.end ? (
                <time datetime={role.end}>{formatMonth(role.end)}</time>
              ) : (
                <span>{tr('common.present')}</span>
              )}
            </p>
            <p class="entry__place">{role.location[locale]}</p>
          </div>
          <div class="entry__body">
            <h3 class="entry__title">{role.title[locale]}</h3>
            <p class="entry__company">
              {role.company}
              {role.companyNote && (
                <span class="entry__company-note">({role.companyNote[locale]})</span>
              )}
            </p>
            <ul class="entry__points">
              {role.points.map((point) => (
                <li>{point[locale]}</li>
              ))}
            </ul>
          </div>
        </li>
      ))
    }
  </ol>

  <div class="entry entry--education">
    <div class="entry__meta">
      <h3 class="mono-label">{tr('experience.education')}</h3>
      <p class="entry__period">
        <time datetime={education.start}>{education.start}</time>
        <span aria-hidden="true"> – </span>
        <span class="visually-hidden"> – </span>
        {
          education.end ? (
            <time datetime={education.end}>{education.end}</time>
          ) : (
            <span>{tr('common.present')}</span>
          )
        }
      </p>
    </div>
    <div class="entry__body">
      <p class="entry__title">{education.degree[locale]}</p>
      <p class="entry__company">{education.school}</p>
    </div>
  </div>
</Section>

<style>
  .highlights {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-6) var(--space-5);
    margin-bottom: var(--space-7);
  }

  .ledger {
    display: grid;
  }

  .entry {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-6);
    border-top: var(--border-hairline);
  }

  .entry--education {
    border-top-color: var(--color-line-strong);
    padding-bottom: 0;
  }

  .entry__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-4);
  }

  .entry__period {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
    color: var(--color-text);
    white-space: nowrap;
  }

  .entry__place {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .entry__body {
    display: grid;
    gap: var(--space-2);
    min-width: 0;
  }

  .entry__title {
    font-size: var(--text-xl);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-tight);
  }

  .entry__company {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-accent);
  }

  .entry__company-note {
    margin-left: 0.4em;
    color: var(--color-text-muted);
  }

  .entry--education .entry__company {
    color: var(--color-text-muted);
  }

  .entry__points {
    display: grid;
    gap: var(--space-3);
    max-width: 70ch;
    margin-top: var(--space-3);
    padding: 0;
    list-style: none;
    color: var(--color-text-muted);
  }

  .entry__points li {
    position: relative;
    padding-left: var(--space-5);
    line-height: 1.55;
  }

  /* Short hairline dash instead of a bullet. */
  .entry__points li::before {
    content: '';
    position: absolute;
    top: 0.78em;
    left: 0;
    width: 0.625rem;
    height: 1px;
    background: var(--color-line-strong);
  }

  @media (min-width: 52rem) {
    .highlights {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      /* Start on the content column, next to the label rail of the header. */
      margin-left: calc(11rem + var(--space-6));
      margin-bottom: var(--space-8);
    }

    .entry {
      grid-template-columns: 11rem minmax(0, 1fr);
      gap: var(--space-6);
      padding-block: var(--space-7);
    }

    .entry--education {
      padding-bottom: 0;
    }

    .entry__meta {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
      padding-top: 0.3em;
    }
  }
</style>
