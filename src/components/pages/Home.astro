---
import Base from '../../layouts/Base.astro';
import Contact from '../home/Contact.astro';
import Experience from '../home/Experience.astro';
import Hero from '../home/Hero.astro';
import MoreProjects from '../home/MoreProjects.astro';
import RustSection from '../home/RustSection.astro';
import Skills from '../home/Skills.astro';
import Work from '../home/Work.astro';
import type { Locale } from '../../i18n';

/** Home page shared by `/` (en) and `/es/` (es). */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<Base locale={locale}>
  <Hero locale={locale} />
  <!-- Same order as `sectionIds` in src/config/site.ts. -->
  <Experience locale={locale} />
  <Work locale={locale} />
  <Skills locale={locale} />
  <MoreProjects locale={locale} />
  <RustSection locale={locale} />
  <Contact locale={locale} />
</Base>
